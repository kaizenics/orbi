# Copy to infra/.env on the server (git-ignored) and fill in. Read by docker compose and the server.

# Public hostname pointing at this VM, e.g. a free DuckDNS name: orbi-yourname.duckdns.org
ORBI_DOMAIN=

# Required: the API is reachable from the internet. Generate with: openssl rand -hex 24
# Use the same value as ORBI_API_TOKEN in the Vercel project of the web app.
ORBI_API_TOKEN=

# AI (optional). OpenRouter example, free model IDs end in ":free":
AI_PROVIDER=openrouter
AI_MODEL=
OPENROUTER_API_KEY=
# Ollama instead (start compose with --profile ollama, then: docker compose exec ollama ollama pull <model>):
# AI_PROVIDER=ollama
# AI_MODEL=qwen3:4b
# OLLAMA_BASE_URL=http://ollama:11434

# Recommended by the Nominatim usage policy.
GEO_CONTACT_EMAIL=
