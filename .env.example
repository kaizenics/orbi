# ORBI configuration. Copy to the package that reads it and fill in values:
#   apps/server/.env   — server variables (ORBI_*)
#   apps/web/.env      — ORBI_API_URL
#   apps/mobile/.env   — EXPO_PUBLIC_API_URL (see apps/mobile/.env.example)
# Never commit .env files. Nothing here requires a paid account.

# --- apps/server ---------------------------------------------------------
# Bind address. 127.0.0.1 = this computer only. Use 0.0.0.0 to reach the
# server from a phone on your LAN (an API token becomes mandatory in Phase 2).
ORBI_HOST=127.0.0.1
ORBI_PORT=3100

# --- apps/web ------------------------------------------------------------
# Where Next.js forwards /api/* requests (server-side only, never exposed).
ORBI_API_URL=http://127.0.0.1:3100
