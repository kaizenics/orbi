# ORBI configuration. Copy the variables you need into the package that reads them:
#   apps/server/.env   server variables (everything below the "apps/server" heading)
#   apps/web/.env.local  the web app (it also runs the API, so all API variables apply)
#   apps/mobile/.env   see apps/mobile/.env.example
# Never commit .env files. Nothing here requires a paid account.

# --- apps/server -----------------------------------------------------------------------------

# Bind address. 127.0.0.1 = this computer only. Use 0.0.0.0 so your phone can reach the server;
# an API token is then mandatory (generate one with: openssl rand -hex 24).
ORBI_HOST=127.0.0.1
ORBI_PORT=3100
ORBI_API_TOKEN=

# Database (libSQL): a local file, or Turso (libsql://<db>.turso.io) with its auth token.
ORBI_DATABASE_URL=file:./data/orbi.db
ORBI_DATABASE_AUTH_TOKEN=

# Browser origins allowed to call the API directly. The web app does not need this (it uses a proxy).
ORBI_CORS_ORIGINS=

# Map tiles (vector style URL). Default: OpenFreeMap, free, no key, provided as-is.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Geocoding. Public Nominatim: max 1 request/second for your whole install, no search-as-you-type.
GEOCODER_PROVIDER=nominatim
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
# Optional search-as-you-type via Photon (komoot public instance or self-hosted).
PHOTON_BASE_URL=

# Routing: one OSRM dataset per travel mode. Default: the FOSSGIS demo (fair use, no SLA).
ROUTER_DRIVING_URL=https://routing.openstreetmap.de/routed-car
ROUTER_WALKING_URL=https://routing.openstreetmap.de/routed-foot
ROUTER_PROFILE=driving

# Public geo services require an identifying User-Agent; a default naming ORBI is used if unset.
# Adding a contact email is recommended by the Nominatim usage policy.
GEO_USER_AGENT=
GEO_CONTACT_EMAIL=
# Minimum gap between requests to one provider. Keep >= 1000 for public instances; 0 if self-hosted.
GEO_MIN_INTERVAL_MS=1100
# How long geocoding and routing results are cached.
CACHE_TTL_DAYS=30

# AI (optional). Unset = AI features off; everything else works.
# AI_PROVIDER=openrouter            # or: ollama
# AI_MODEL=                         # OpenRouter model ID (":free" models cost $0) or an Ollama model
# OPENROUTER_API_KEY=               # server-side only; never in NEXT_PUBLIC_* / EXPO_PUBLIC_*
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- apps/web --------------------------------------------------------------------------------

# Only when the API runs on a separate server (VM): the web app forwards /api there.
# Unset = the API runs inside the web app (recommended; e.g. on Vercel).
# ORBI_API_URL=https://api.example.com

# Production builds refuse to serve trips without Google sign-in. Set to 1 only for a trusted,
# private machine (never on a public host).
# ORBI_ALLOW_OPEN=1

# Google sign-in (required when deployed; leave unset for open local development).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ORBI_ALLOWED_EMAILS=you@gmail.com
# ORBI_SESSION_SECRET=              # openssl rand -hex 32
