{
  "name": "@orbi/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Server-only. Drizzle schema, migrations and repositories for ORBI (SQLite).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env src/migrate.ts"
  },
  "devDependencies": {
    "@orbi/eslint-config": "workspace:*",
    "@orbi/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "0.31.11",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@orbi/core": "workspace:*",
    "drizzle-orm": "0.45.4"
  }
}
