{
  "name": "@orbi/api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "ORBI HTTP API (Hono). Apps may import only the ./client entry and types.",
  "exports": {
