  },
  "devDependencies": {
    "@orbi/eslint-config": "workspace:*",
    "@orbi/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
