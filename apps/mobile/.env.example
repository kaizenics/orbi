# Default ORBI server URL for the app. Use your computer's LAN IP, not localhost:
# on a phone or emulator, localhost is the device itself. (Android emulator: http://10.0.2.2:3100)
EXPO_PUBLIC_API_URL=http://192.168.1.10:3100

# Only if the server runs with ORBI_API_TOKEN (required when it is reachable from your phone).
# Note: EXPO_PUBLIC_* values are embedded in the app bundle.
EXPO_PUBLIC_API_TOKEN=
